generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  fullName              String
  profileImage          String?
  authProvider          String      @default("clerk")
  emailVerified         Boolean     @default(false)
  accountStatus         String      @default("active")
  
  profile               UserProfile?
  bookmarkedOpportunities Bookmark[]
  recentSearches        RecentSearch[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?
}

model UserProfile {
  id                    String      @id @default(uuid())
  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id])
  
  highestQualification  String?
  currentCollege        String?
  graduationYear        Int?
  experienceLevel       String?
  currentCompany        String?
  currentDesignation    String?
  preferredSalary       String?
  preferredEmploymentType String?
  remotePreference      Boolean     @default(false)
  
  skills                UserSkill[]
  preferredRoles        UserPreferredRole[]
  preferredLocations    UserPreferredLocation[]
  preferredIndustries   UserPreferredIndustry[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model Skill {
  id                    String      @id @default(uuid())
  name                  String      @unique
  
  userSkills            UserSkill[]
  opportunitySkills     OpportunitySkill[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model UserSkill {
  userId                String
  skillId               String
  userProfile           UserProfile @relation(fields: [userId], references: [userId])
  skill                 Skill       @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
}

model UserPreferredRole {
  id                    String      @id @default(uuid())
  userId                String
  roleName              String
  userProfile           UserProfile @relation(fields: [userId], references: [userId])
  
  @@unique([userId, roleName])
}

model UserPreferredLocation {
  id                    String      @id @default(uuid())
  userId                String
  locationName          String
  userProfile           UserProfile @relation(fields: [userId], references: [userId])

  @@unique([userId, locationName])
}

model UserPreferredIndustry {
  id                    String      @id @default(uuid())
  userId                String
  industryName          String
  userProfile           UserProfile @relation(fields: [userId], references: [userId])

  @@unique([userId, industryName])
}

model Company {
  id                    String      @id @default(uuid())
  companyName           String      @unique
  slug                  String      @unique
  logoUrl               String?
  website               String?
  officialCareerPage    String
  companyType           String?
  industry              String?
  country               String      @default("India")
  state                 String?
  city                  String?
  headquarters          String?
  description           String?
  
  careersSupported      Boolean     @default(true)
  crawlerEnabled        Boolean     @default(false)
  crawlFrequencyHours   Int         @default(24)
  lastCrawledAt         DateTime?
  nextCrawlAt           DateTime?
  crawlerStatus         String      @default("idle") // idle, crawling, error
  totalLiveJobs         Int         @default(0)
  
  // Note: Prisma does not support enums with SQLite provider. 
  // Using String to maintain SQLite & PostgreSQL cross-compatibility as requested.
  atsType               String      @default("UNKNOWN") // WORKDAY, SUCCESSFACTORS, UNKNOWN, CUSTOM
  atsVerified           Boolean     @default(false)
  atsLastVerifiedAt     DateTime?
  
  status                String      @default("active")
  linkedInUrl           String?
  foundedYear           Int?
  
  locations             CompanyLocation[]
  opportunities         Opportunity[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  @@index([companyName])
  @@index([crawlerEnabled])
  @@index([nextCrawlAt])
  @@index([companyType])
}

model CompanyLocation {
  id                    String      @id @default(uuid())
  companyId             String
  company               Company     @relation(fields: [companyId], references: [id])
  city                  String
  state                 String
  country               String      @default("India")
  latitude              Float?
  longitude             Float?
  officeType            String?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model Opportunity {
  id                    String      @id @default(uuid())
  companyId             String
  company               Company     @relation(fields: [companyId], references: [id])
  
  title                 String
  slug                  String      @unique
  category              String
  employmentType        String
  
  experienceRequired    Boolean     @default(false)
  minExperience         Int?
  maxExperience         Int?
  
  location              String?
  city                  String?
  state                 String?
  country               String?
  
  isRemote              Boolean     @default(false)
  isHybrid              Boolean     @default(false)
  
  salary                String?
  applyUrl              String
  officialSourceUrl     String
  sourceATS             String?
  externalJobId         String?
  
  description           String?
  
  publishedDate         DateTime
  expiryDate            DateTime?
  status                String      @default("open") // open, closed, archived
  
  skills                OpportunitySkill[]
  bookmarks             Bookmark[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  @@index([title])
  @@index([publishedDate])
  @@index([city])
  @@index([state])
  @@index([category])
  @@index([employmentType])
}

model OpportunitySkill {
  opportunityId         String
  skillId               String
  opportunity           Opportunity @relation(fields: [opportunityId], references: [id])
  skill                 Skill       @relation(fields: [skillId], references: [id])

  @@id([opportunityId, skillId])
}

model Bookmark {
  userId                String
  opportunityId         String
  user                  User        @relation(fields: [userId], references: [id])
  opportunity           Opportunity @relation(fields: [opportunityId], references: [id])
  savedAt               DateTime    @default(now())

  @@id([userId, opportunityId])
}

model RecentSearch {
  id                    String      @id @default(uuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  query                 String
  searchedAt            DateTime    @default(now())
}

model City {
  id                    String      @id @default(uuid())
  name                  String
  state                 String
  country               String      @default("India")
  latitude              Float?
  longitude             Float?

  @@unique([name, state])
}

model State {
  id                    String      @id @default(uuid())
  name                  String      @unique
}

model Industry {
  id                    String      @id @default(uuid())
  name                  String      @unique
}
